# EmailJS — create a free account at https://www.emailjs.com/
# Dashboard → Email Services (Service ID), Email Templates (Template ID),
# Account → API Keys (Public Key). Copy this file to ".env" and fill in.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# The address shown on the site / used as a fallback (optional)
VITE_CONTACT_EMAIL=faizanjaved5565@gmail.com
